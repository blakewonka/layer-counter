{
  // Solution-style root: no files of its own. Editors use the references to
  // find the project (and therefore the `lib` settings) that owns a file;
  // `npm run typecheck` runs the three projects directly.
  "files": [],
  "references": [
    { "path": "./tsconfig.plugin.json" },
    { "path": "./tsconfig.ui.json" },
    { "path": "./tsconfig.test.json" }
  ]
}
