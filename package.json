{
  "name": "figma-layer-counter",
  "version": "1.0.0",
  "description": "Layer counter plugin for Figma.",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.plugin.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "test": "node --test test/",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.141.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
